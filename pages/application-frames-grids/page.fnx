        <Text align="left" auto_resize="height" blend_mode="normal" content="Dividers are used to separate various areas. They are 2 px in thickness on desktop scale and 1 px on mobile scale to better fit platform conventions. These dividers are opaque and are designed to always remain darker than bars and panels." id="01M4V5T780N64X1ESNYV8QWZS1" layout_child={{"align_self": "stretch"}} local_size={[950.0, 84.0]} meta={{"figma_id": "349:41494", "figma_type": "TEXT"}} name="Dividers are used to separate various areas. They are 2 px in thickness on desktop scale and 1 px on mobile scale to better fit platform conventions. These dividers are opaque and are designed to always remain darker than bars and panels." opacity={1.0} style={{"color": fnxColor("#222222"), "font_family": "Source Sans Pro", "italic": false, "letter_spacing": 0.0, "line_height": 1.399999976158142, "size_px": 20.0, "weight": 400}} vertical_align="center" x={96.0} y={3468.0} />
