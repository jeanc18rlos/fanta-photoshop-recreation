        <Text align="left" auto_resize="height" blend_mode="normal" content="The tab bar only exists on mobile phone applications. It is a good alternative to sidebars and a natural place for interactions, as it is easy to reach and accommodates well for landscape views." id="01M4V5T780X0QJV0HY19NY102Z" layout_child={{"align_self": "stretch"}} local_size={[950.0, 56.0]} meta={{"figma_id": "349:41500", "figma_type": "TEXT"}} name="The tab bar only exists on mobile phone applications. It is a good alternative to sidebars and a natural place for interactions, as it is easy to reach and accommodates well for landscape views." opacity={1.0} style={{"color": fnxColor("#222222"), "font_family": "Source Sans Pro", "italic": false, "letter_spacing": 0.0, "line_height": 1.399999976158142, "size_px": 20.0, "weight": 400}} vertical_align="center" x={96.0} y={2874.0} />
