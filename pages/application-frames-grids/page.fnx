        <Text align="left" auto_resize="height" blend_mode="normal" content="The application frame structure tends to be static and stable. Therefore transient states (e.g., menus, options, settings, additional actions) are conveyed using different containers: popovers and trays" id="01M4V5T7802MY5B6BCXM2MK75F" layout_child={{"align_self": "stretch"}} local_size={[950.0, 56.0]} meta={{"figma_id": "349:41506", "figma_type": "TEXT"}} name="The application frame structure tends to be static and stable. Therefore transient states (e.g., menus, options, settings, additional actions) are conveyed using different containers: popovers and trays" opacity={1.0} style={{"color": fnxColor("#222222"), "font_family": "Source Sans Pro", "italic": false, "letter_spacing": 0.0, "line_height": 1.399999976158142, "size_px": 20.0, "weight": 400}} vertical_align="center" x={96.0} y={4090.0} />
