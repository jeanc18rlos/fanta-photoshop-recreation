        <Text align="left" auto_resize="height" blend_mode="normal" content="The header bar contains the highest level of navigation and action items (e.g., modes, file name, global actions, syncing, sharing). For this reason, it is always present at the top and is consistent across all platforms." id="01M4V5T780QV31Y7FF84J7ET49" layout_child={{"align_self": "stretch"}} local_size={[950.0, 56.0]} meta={{"figma_id": "349:41479", "figma_type": "TEXT"}} name="The header bar contains the highest level of navigation and action items (e.g., modes, file name, global actions, syncing, sharing). For this reason, it is always present at the top and is consistent across all platforms." opacity={1.0} style={{"color": fnxColor("#222222"), "font_family": "Source Sans Pro", "italic": false, "letter_spacing": 0.0, "line_height": 1.399999976158142, "size_px": 20.0, "weight": 400}} vertical_align="center" x={96.0} y={860.0} />
