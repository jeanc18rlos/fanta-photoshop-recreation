    {
      "id": "01M4V5T7B0007KZDM1N678YQ70",
      "index": 2.0,
      "name": "Each platform and context require the use of an appropriate scale. Desktop platforms, like macOS, use the desktop scale. Mobile platforms, like iOS and Android, use the mobile scale. Other platforms that may blur the line between desktop and mobile experiences, such as a device with a touch-enabled desktop screen, should accommodate both scales. For instance, web browsers should display the correct scale based on the width of the browser window.",
      "parent_index": 16,
      "tag": "Text"
    }
