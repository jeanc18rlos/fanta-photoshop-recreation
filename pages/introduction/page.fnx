            <Text align="left" auto_resize="height" blend_mode="normal" content="Spectrum provides components and tools to help product teams work more efficiently, and to make Adobe’s applications more cohesive. It's deeply committed to a high standard of accessibility, honesty, and respect for user attention. Every component, pattern, and principle is informed by research and thoughtful testing.\n\nLearn more about Spectrum’s principles →" id="01M4V5T7B044YDWX5PX759P89A" layout_child={{"align_self": "stretch"}} local_size={[768.0, 162.0]} meta={{"figma_id": "432:37958", "figma_type": "TEXT"}} name="Description" opacity={1.0} style={{"color": fnxColor("#222222"), "font_family": "Source Sans Pro", "italic": false, "letter_spacing": 0.0, "line_height": 1.5, "size_px": 18.0, "weight": 400}} style_runs={[{"end": 323, "start": 322, "style": {"color": fnxColor("#0265DC"), "font_family": "Source Sans Pro", "italic": false, "letter_spacing": 0.0, "line_height": 1.5, "size_px": 18.0, "weight": 600}}, {"end": 367, "start": 323, "style": {"color": fnxColor("#0265DC"), "font_family": "Source Sans Pro", "italic": false, "letter_spacing": 0.0, "line_height": 1.5, "size_px": 18.0, "weight": 400}}]} vertical_align="center" x={0.0} y={68.0} />
          </Frame>
          <Frame auto_layout={{"child_layout": true, "counter_align": "start", "counter_sizing": "fixed", "counter_spacing": 0.0, "flow_reverse": false, "mode": "vertical", "padding": [0.0, 0.0, 0.0, 0.0], "primary_align": "start", "primary_sizing": "fixed", "reverse_z": false, "spacing": 24.0, "wrap": false}} blend_mode="normal" clip_size={[768.0, 284.0]} flags="LOCKED" id="01M4V5T7B0RH6V6W36V3KPB4XB" layout_child={{"align_self": "stretch"}} meta={{"clip_content": false, "figma_id": "433:37994", "figma_type": "FRAME"}} name="Platform Scale" opacity={1.0} scroll_direction="none" scrollable={true} x={96.0} y={1036.0}>
            <Instance blend_mode="normal" component="_Section" derived={[{"path": ["01M4V5T70HKA6ZSRTKK3057RJC"], "size": [768.0, 28.0]}, {"path": ["01M4V5T70HKA6ZSRTKK3057RJC", "01M4V5T70HMKBZGXCXGX1DEWBH"], "size": [768.0, 28.0], "text": {"family": "Source Sans Pro", "font_size": 22.0, "weight": 700}}, {"path": ["01M4V5T70HH6CJ3B3ANRM5DFA8"], "path_data": {"segments": [{"op": "move", "to": [0.0, 2.0]}, {"ctrl1": [0.0, 0.8954305052757263], "ctrl2": [0.8954305648803711, 0.0], "op": "cubic", "to": [2.0, 0.0]}, {"op": "line", "to": [766.0, 0.0]}, {"ctrl1": [767.1045532226562, 0.0], "ctrl2": [768.0, 0.8954305052757263], "op": "cubic", "to": [768.0, 2.0]}, {"op": "line", "to": [768.0, 2.0]}, {"ctrl1": [768.0, 3.104569435119629], "ctrl2": [767.1045532226562, 4.0], "op": "cubic", "to": [766.0, 4.0]}, {"op": "line", "to": [2.0000152587890625, 4.0]}, {"ctrl1": [0.8954457640647888, 4.0], "ctrl2": [0.0, 3.104569435119629], "op": "cubic", "to": [0.0, 2.0]}, {"op": "line", "to": [0.0, 2.0]}, {"op": "close"}]}, "size": [768.0, 4.0]}]} id="01M4V5T7B0TW5PJ2YPXV5SKEK2" layout_child={{"align_self": "stretch"}} local_size={[768.0, 44.0]} meta={{"clip_content": false, "figma_id": "433:37995", "figma_type": "INSTANCE"}} name="_Section" opacity={1.0} overrides={[{"target_path": [], "target_prop": {"prop": "visible"}, "value": {"kind": "field", "value": {"clip_size": [768.0, 44.0]}}}, {"target_path": ["01M4V5T70HKA6ZSRTKK3057RJC", "01M4V5T70HMKBZGXCXGX1DEWBH"], "target_prop": {"prop": "text_content"}, "value": {"kind": "text", "value": "Platform Scale"}}]} prop_values={{"01M4V5T7GQ5EJKXA5ZRFA1YX94": {"kind": "string", "value": "Platform Scale"}}} x={0.0} y={0.0} />
            <Text align="left" auto_resize="height" blend_mode="normal" content="Spectrum is designed for multiple platforms. There are two different scales for user interfaces in order to accommodate cursor and touch experiences: a desktop scale and a mobile scale. \n\nMobile components are larger than their desktop counterparts. Spectrum uses a 1:1.25 scale ratio. This means that a mobile component is 25% larger than its desktop counterpart, and a desktop component is 20% smaller than its mobile counterpart.\n\nLearn more about platform scale →" id="01M4V5T7B0ZVY2MQVZST0GSEER" layout_child={{"align_self": "stretch"}} local_size={[768.0, 216.0]} meta={{"figma_id": "433:37996", "figma_type": "TEXT"}} name="Description" opacity={1.0} style={{"color": fnxColor("#222222"), "font_family": "Source Sans Pro", "italic": false, "letter_spacing": 0.0, "line_height": 1.5, "size_px": 18.0, "weight": 400}} style_runs={[{"end": 434, "start": 433, "style": {"color": fnxColor("#0265DC"), "font_family": "Source Sans Pro", "italic": false, "letter_spacing": 0.0, "line_height": 1.5, "size_px": 18.0, "weight": 600}}, {"end": 469, "start": 434, "style": {"color": fnxColor("#0265DC"), "font_family": "Source Sans Pro", "italic": false, "letter_spacing": 0.0, "line_height": 1.5, "size_px": 18.0, "weight": 400}}]} vertical_align="center" x={0.0} y={68.0} />
          </Frame>
          <Frame auto_layout={{"child_layout": true, "counter_align": "start", "counter_sizing": "fixed", "counter_spacing": 0.0, "flow_reverse": false, "mode": "vertical", "padding": [0.0, 0.0, 0.0, 0.0], "primary_align": "start", "primary_sizing": "fixed", "reverse_z": false, "spacing": 24.0, "wrap": false}} blend_mode="normal" clip_size={[768.0, 257.0]} flags="LOCKED" id="01M4V5T7B03RTXKD0AVTZZ5N96" layout_child={{"align_self": "stretch"}} meta={{"clip_content": false, "figma_id": "433:38036", "figma_type": "FRAME"}} name="Color System" opacity={1.0} scroll_direction="none" scrollable={true} x={96.0} y={1368.0}>
            <Instance blend_mode="normal" component="_Section" derived={[{"path": ["01M4V5T70HKA6ZSRTKK3057RJC"], "size": [768.0, 28.0]}, {"path": ["01M4V5T70HKA6ZSRTKK3057RJC", "01M4V5T70HMKBZGXCXGX1DEWBH"], "size": [768.0, 28.0], "text": {"family": "Source Sans Pro", "font_size": 22.0, "weight": 700}}, {"path": ["01M4V5T70HH6CJ3B3ANRM5DFA8"], "path_data": {"segments": [{"op": "move", "to": [0.0, 2.0]}, {"ctrl1": [0.0, 0.8954305052757263], "ctrl2": [0.8954305648803711, 0.0], "op": "cubic", "to": [2.0, 0.0]}, {"op": "line", "to": [766.0, 0.0]}, {"ctrl1": [767.1045532226562, 0.0], "ctrl2": [768.0, 0.8954305052757263], "op": "cubic", "to": [768.0, 2.0]}, {"op": "line", "to": [768.0, 2.0]}, {"ctrl1": [768.0, 3.104569435119629], "ctrl2": [767.1045532226562, 4.0], "op": "cubic", "to": [766.0, 4.0]}, {"op": "line", "to": [2.0000152587890625, 4.0]}, {"ctrl1": [0.8954457640647888, 4.0], "ctrl2": [0.0, 3.104569435119629], "op": "cubic", "to": [0.0, 2.0]}, {"op": "line", "to": [0.0, 2.0]}, {"op": "close"}]}, "size": [768.0, 4.0]}]} id="01M4V5T7B061PYR13CR0ZJRC5Q" layout_child={{"align_self": "stretch"}} local_size={[768.0, 44.0]} meta={{"clip_content": false, "figma_id": "433:38037", "figma_type": "INSTANCE"}} name="_Section" opacity={1.0} overrides={[{"target_path": [], "target_prop": {"prop": "visible"}, "value": {"kind": "field", "value": {"clip_size": [768.0, 44.0]}}}, {"target_path": ["01M4V5T70HKA6ZSRTKK3057RJC", "01M4V5T70HMKBZGXCXGX1DEWBH"], "target_prop": {"prop": "text_content"}, "value": {"kind": "text", "value": "Color System"}}]} prop_values={{"01M4V5T7GQ5EJKXA5ZRFA1YX94": {"kind": "string", "value": "Color System"}}} x={0.0} y={0.0} />
            <Text align="left" auto_resize="height" blend_mode="normal" content="Spectrum uses the relationships between colors and their properties to create a scalable foundation for color in the design system. This is based on a foundation of visual perception, inclusive design, and accessibility. There are four color themes included in this file: light, dark, darkest, and wireframe. Spectrum uses 11 tints and shades of gray per color theme and there are 13 colors per color theme with a set of 14 tints and shades per color.\n\nLearn more about the color system →" id="01M4V5T7B078DEJ3ZWX23SA82X" layout_child={{"align_self": "stretch"}} local_size={[768.0, 189.0]} meta={{"figma_id": "433:38038", "figma_type": "TEXT"}} name="Description" opacity={1.0} style={{"color": fnxColor("#222222"), "font_family": "Source Sans Pro", "italic": false, "letter_spacing": 0.0, "line_height": 1.5, "size_px": 18.0, "weight": 400}} style_runs={[{"end": 453, "start": 452, "style": {"color": fnxColor("#0265DC"), "font_family": "Source Sans Pro", "italic": false, "letter_spacing": 0.0, "line_height": 1.5, "size_px": 18.0, "weight": 600}}, {"end": 490, "start": 453, "style": {"color": fnxColor("#0265DC"), "font_family": "Source Sans Pro", "italic": false, "letter_spacing": 0.0, "line_height": 1.5, "size_px": 18.0, "weight": 400}}]} vertical_align="center" x={0.0} y={68.0} />
          </Frame>
