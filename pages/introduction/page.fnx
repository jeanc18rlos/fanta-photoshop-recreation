            <Text align="left" auto_resize="height" blend_mode="normal" content="Components in the Spectrum Design System are grouped based on the following categories:\n\nActions\nAction Bar, Action Button, Button, Menu, Quick Actions\n\nContainers\nDivider, Tray\n\nData Visualization\nArea Chart, Bar Chart, Big Number, Donut Chart, Histogram, Line Chart, Scatter Plot\n\nFeedback\nAlert Dialog, Coach Mark, Color Loupe, In-Line Alert, Toast, Tooltip\n\nInputs\nCheckbox, Color Area, Color Slider, Color Wheel, Combo Box, Picker, Radio Button, Rating, Slider, Swatch, Switch, Text Field\n\nNavigation\nAvatar, Breadcrumbs, Scroll-Zoom Bar, Side Navigation, Tabs, Tag, Tab Bar\n\nStatus\nBadge, Meter, Progress Bar, Progress Circle, Status Light\n\nPatterns\nCards, Table" id="01M4V5T7B09JWEAZD5AAZ6H8B3" layout_child={{"align_self": "stretch"}} local_size={[768.0, 702.0]} meta={{"figma_id": "433:38049", "figma_type": "TEXT"}} name="Description" opacity={1.0} style={{"color": fnxColor("#222222"), "font_family": "Source Sans Pro", "italic": false, "letter_spacing": 0.0, "line_height": 1.5, "size_px": 18.0, "weight": 400}} style_runs={[{"end": 97, "start": 89, "style": {"color": fnxColor("#222222"), "font_family": "Source Sans Pro", "italic": false, "letter_spacing": 0.0, "line_height": 1.5, "size_px": 18.0, "weight": 700}}, {"end": 164, "start": 153, "style": {"color": fnxColor("#222222"), "font_family": "Source Sans Pro", "italic": false, "letter_spacing": 0.0, "line_height": 1.5, "size_px": 18.0, "weight": 700}}, {"end": 198, "start": 179, "style": {"color": fnxColor("#222222"), "font_family": "Source Sans Pro", "italic": false, "letter_spacing": 0.0, "line_height": 1.5, "size_px": 18.0, "weight": 700}}, {"end": 292, "start": 283, "style": {"color": fnxColor("#222222"), "font_family": "Source Sans Pro", "italic": false, "letter_spacing": 0.0, "line_height": 1.5, "size_px": 18.0, "weight": 700}}, {"end": 369, "start": 362, "style": {"color": fnxColor("#222222"), "font_family"