            <Instance blend_mode="normal" component="_Section" derived={[{"path": ["01M4V5T70HKA6ZSRTKK3057RJC"], "size": [768.0, 28.0]}, {"path": ["01M4V5T70HKA6ZSRTKK3057RJC", "01M4V5T70HMKBZGXCXGX1DEWBH"], "size": [768.0, 28.0], "text": {"family": "Source Sans Pro", "font_size": 22.0, "weight": 700}}, {"path": ["01M4V5T70HH6CJ3B3ANRM5DFA8"], "path_data": {"segments": [{"op": "move", "to": [0.0, 2.0]}, {"ctrl1": [0.0, 0.8954305052757263], "ctrl2": [0.8954305648803711, 0.0], "op": "cubic", "to": [2.0, 0.0]}, {"op": "line", "to": [766.0, 0.0]}, {"ctrl1": [767.1045532226562, 0.0], "ctrl2": [768.0, 0.8954305052757263], "op": "cubic", "to": [768.0, 2.0]}, {"op": "line", "to": [768.0, 2.0]}, {"ctrl1": [768.0, 3.104569435119629], "ctrl2": [767.1045532226562, 4.0], "op": "cubic", "to": [766.0, 4.0]}, {"op": "line", "to": [2.0000152587890625, 4.0]}, {"ctrl1": [0.8954457640647888, 4.0], "ctrl2": [0.0, 3.104569435119629], "op": "cubic", "to": [0.0, 2.0]}, {"op": "line", "to": [0.0, 2.0]}, {"op": "close"}]}, "size": [768.0, 4.0]}]} id="01M4V5T7B0J3F7MQPHAXC49H0Z" layout_child={{"align_self": "stretch"}} local_size={[768.0, 44.0]} meta={{"clip_content": false, "figma_id": "433:38066", "figma_type": "INSTANCE"}} name="_Section" opacity={1.0} overrides={[{"target_path": [], "target_prop": {"prop": "visible"}, "value": {"kind": "field", "value": {"clip_size": [768.0, 44.0]}}}, {"target_path": ["01M4V5T70HKA6ZSRTKK3057RJC", "01M4V5T70HMKBZGXCXGX1DEWBH"], "target_prop": {"prop": "text_content"}, "value": {"kind": "text", "value": "Fonts"}}]} prop_values={{"01M4V5T7GQ5EJKXA5ZRFA1YX94": {"kind": "string", "value": "Fonts"}}} x={0.0} y={0.0} />
            <Text align="left" auto_resize="height" blend_mode="normal" content="Spectrum uses Adobe’s brand font families, Adobe Clean. However, these are restricted fonts for the exclusive use of Adobe products and software and are not licensed for use in external products. Furthermore, they would need to be downloaded through the Adobe Developer Console using an Adobe ID and one would need to accept the Adobe Developer Terms of Use before installing them.\n\nIn order to circumvent these inconveniences, this file uses Adobe’s open-source fonts that are available on Google Fonts and are already pre-installed in Figma. There are three open-source fonts used in this design system: Source Sans Pro, Source Serif Pro, and Source Code Pro." id="01M4V5T7B08MNN2QZ5F8PS1KHT" layout_child={{"align_self": "stretch"}} local_size={[768.0, 216.0]} meta={{"figma_id": "433:38067", "figma_type": "TEXT"}} name="Description" opacity={1.0} style={{"color": fnxColor("#222222"), "font_family": "Source Sans Pro", "italic": false, "letter_spacing": 0.0, "line_height": 1.5, "size_px": 18.0, "weight": 400}} style_runs={[{"end": 93, "start": 77, "style": {"color": fnxColor("#0265DC"), "font_family": "Source Sans Pro", "italic": false, "letter_spacing": 0.0, "line_height": 1.5, "size_px": 18.0, "weight": 400}}, {"end": 625, "start": 610, "style": {"color": fnxColor("#0265DC"), "font_family": "Source Sans Pro", "italic": false, "letter_spacing": 0.0, "line_height": 1.5, "size_px": 18.0, "weight": 400}}, {"end": 643, "start": 627, "style": {"color": fnxColor("#0265DC"), "font_family": "Source Sans Pro", "italic": false, "letter_spacing": 0.0, "line_height": 1.5, "size_px": 18.0, "weight": 400}}, {"end": 664, "start": 649, "style": {"color": fnxColor("#0265DC"), "font_family": "Source Sans Pro", "italic": false, "letter_spacing": 0.0, "line_height": 1.5, "size_px": 18.0, "weight": 400}}]} vertical_align="center" x={0.0} y={68.0} />
