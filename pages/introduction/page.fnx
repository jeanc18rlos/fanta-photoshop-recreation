            <Text align="left" auto_resize="height" blend_mode="normal" content="Almost every component available in this file leverages the most recent Figma features such as Auto Layout, Variants, editable text properties, instance swaps for icons, boolean visibility toggles, and exposed nested instances. These definitions are consolidated into a single set of controls in the right sidebar. Anyone editing the instance can use these controls to understand what is changeable and to make edits. This removes the need to select and override individual layers, reduces time needed to refer to documentation, and improves accurate usage of components." id="01M4V5T7B0A1ZJ8JSTP0WV8FW1" layout_child={{"align_self": "stretch"}} local_size={[768.0, 162.0]} meta={{"figma_id": "433:38055", "figma_type": "TEXT"}} name="Description" opacity={1.0} style={{"color": fnxColor("#222222"), "font_family": "Source Sans Pro", "italic": false, "letter_spacing": 0.0, "line_height": 1.5, "size_px": 18.0, "weight": 400}} vertical_align="center" x={0.0} y={68.0} />
